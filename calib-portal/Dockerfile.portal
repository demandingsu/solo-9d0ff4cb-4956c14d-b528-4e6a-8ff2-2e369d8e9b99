# 模拟旧门户：纯 FastAPI，无需浏览器、无账号
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PORTAL_DB=/data/portal.db

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /portal
COPY portal/requirements.txt /portal/requirements.txt
RUN pip install -r /portal/requirements.txt
COPY portal /portal

RUN mkdir -p /data && \
    adduser --disabled-password --gecos "" portaluser && \
    chown -R portaluser:portaluser /data /portal
USER portaluser

EXPOSE 8080
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8080"]
